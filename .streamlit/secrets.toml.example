# Copy to .streamlit/secrets.toml (local) or paste into Settings -> Secrets (Streamlit Cloud).
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"   # Cloud: https://<app>.streamlit.app/oauth2callback
cookie_secret = "a-long-random-string"                  # python -c "import secrets; print(secrets.token_urlsafe(32))"
client_id = ""                                          # Google Cloud -> Google Auth Platform -> Clients
client_secret = ""
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
expose_tokens = ["access"]                              # the app calls the Search Console API with this token

[auth.client_kwargs]
scope = "openid email profile https://www.googleapis.com/auth/webmasters.readonly"
prompt = "select_account"
